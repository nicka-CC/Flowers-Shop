<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MyApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">?buttonTextColor</item>
        <item name="backgroundTint">?buttonBackgroundColor</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MyApp.TextView.Title" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?titleTextColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
